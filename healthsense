// Called when a heartbeat is detected
void onBeatDetected() {
  Serial.println("Beat detected");
}

// Serve the dashboard page
void handleRoot() {
  server.send_P(200, "text/html", INDEX_HTML);
}

// Send sensor readings as JSON
void handleData() {
  String json = "{";

  json += "\"sensorReady\":";
  json += (sensorReady ? "true" : "false");

  json += ",\"bpmValid\":";
  json += (bpmValid ? "true" : "false");

  json += ",\"spo2Valid\":";
  json += (spo2Valid ? "true" : "false");

  json += ",\"bpm\":";
  json += String(lastValidBPM, 1);

  json += ",\"spo2\":";
  json += String(lastValidSpO2, 1);

  json += "}";

  server.sendHeader("Cache-Control", "no-store");
  server.send(200, "application/json", json);
}

// Setup
void setup() {
  Serial.begin(115200);
  delay(300);

  Serial.println();
  Serial.println("MARVEL Task 7 - Health Vitals Dashboard");

  // Start I2C communication
  Wire.begin(I2C_SDA, I2C_SCL);

  // Initialize MAX30100
  Serial.println("Initializing MAX30100...");

  sensorReady = pox.begin();

  if (sensorReady) {
    // LED current may need adjustment for your sensor module
    pox.setIRLedCurrent(MAX30100_LED_CURR_14_2MA);
    pox.setOnBeatDetectedCallback(onBeatDetected);

    Serial.println("MAX30100 initialized successfully.");
  } else {
    Serial.println("ERROR: MAX30100 initialization failed.");
    Serial.println("Check VCC, GND, SDA/SCL, and the installed library.");
  }

  // Connect to Wi-Fi
  WiFi.mode(WIFI_STA);
  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);

  Serial.print("Connecting to Wi-Fi");

  unsigned long wifiStart = millis();

  while (
    WiFi.status() != WL_CONNECTED &&
    millis() - wifiStart < 20000
  ) {
    delay(300);
    Serial.print(".");
  }

  Serial.println();

  if (WiFi.status() == WL_CONNECTED) {
    Serial.println("Wi-Fi connected.");

    Serial.print("ESP32 IP address: ");
    Serial.println(WiFi.localIP());

    Serial.print("Signal strength (RSSI): ");
    Serial.println(WiFi.RSSI());

  } else {
    Serial.println("Wi-Fi connection timed out.");
    Serial.println("Check SSID and password.");
  }

  // Configure web server routes
  server.on("/", HTTP_GET, handleRoot);
  server.on("/data", HTTP_GET, handleData);

  // Start web server
  server.begin();

  Serial.println("Web server started.");
  Serial.println(
    "Connect your computer to the same Wi-Fi and open the IP above."
  );
}

// Main loop
void loop() {
  // Call frequently so the sensor algorithm can update
  if (sensorReady) {
    pox.update();
  }

  // Read and process measurements once per second
  unsigned long now = millis();

  if (
    sensorReady &&
    now - lastSampleTime >= SAMPLE_INTERVAL_MS
  ) {
    lastSampleTime = now;

    float bpm = pox.getHeartRate();
    float spo2 = pox.getSpO2();

    // Basic plausibility filters, not medical validation
    if (bpm >= 50.0f && bpm <= 180.0f) {
      lastValidBPM = bpm;
      bpmValid = true;
    }

    if (spo2 >= 80.0f && spo2 <= 100.0f) {
      lastValidSpO2 = spo2;
      spo2Valid = true;
    }

    Serial.print("Raw BPM: ");
    Serial.print(bpm);

    Serial.print(" | Raw SpO2: ");
    Serial.print(spo2);

    Serial.print(" | Display BPM: ");

    if (bpmValid) {
      Serial.print(lastValidBPM, 1);
    } else {
      Serial.print("--");
    }

    Serial.print(" | Display SpO2: ");

    if (spo2Valid) {
      Serial.println(lastValidSpO2, 1);
    } else {
      Serial.println("--");
    }
  }

  // Handle browser requests
  server.handleClient();
}
