// Display the home page
void handleRoot() {
  server.send(200, "text/html", makePage());
}

// Receive text and flash the corresponding Morse code
void handleSend() {
  String message = server.arg("text");
  message.trim();

  if (message.length() == 0) {
    server.send(400, "text/plain", "Please enter a message.");
    return;
  }

  if (message.length() > 80) {
    server.send(400, "text/plain", "Message is too long.");
    return;
  }

  String morse = convertToMorse(message);

  server.send(
    200,
    "text/html",
    makePage(message, morse, "Flashing Morse code...")
  );

  Serial.print("Message: ");
  Serial.println(message);

  Serial.print("Morse code: ");
  Serial.println(morse);

  flashMorse(morse);

  Serial.println("Morse transmission complete.");
}

// Initialize ESP32
void setup() {
  pinMode(LED_PIN, OUTPUT);
  digitalWrite(LED_PIN, LOW);

  Serial.begin(115200);
  delay(500);

  Serial.println();
  Serial.println("MARVEL Task 6 - Morse Code");

  WiFi.mode(WIFI_STA);
  WiFi.begin(ssid, password);

  Serial.print("Connecting to Wi-Fi...");

  unsigned long startTime = millis();

  while (WiFi.status() != WL_CONNECTED &&
         millis() - startTime < 30000) {
    delay(500);
    Serial.print(".");
  }

  Serial.println();

  if (WiFi.status() != WL_CONNECTED) {
    Serial.println("Wi-Fi connection failed.");
    Serial.println("Check SSID, password and 2.4 GHz Wi-Fi.");
    return;
  }

  Serial.println("Wi-Fi connected!");
  Serial.print("Open: http://");
  Serial.println(WiFi.localIP());

  server.on("/", HTTP_GET, handleRoot);
  server.on("/send", HTTP_GET, handleSend);

  server.onNotFound([]() {
    server.send(404, "text/plain", "Page not found.");
  });

  server.begin();

  Serial.println("Web server started.");
}

// Continuously handle browser requests
void loop() {
  if (WiFi.status() == WL_CONNECTED) {
    server.handleClient();
  }
}
```

## How to Run

1. Replace `YOUR_WIFI_NAME` and `YOUR_WIFI_PASSWORD` with your Wi-Fi credentials.
2. Select your ESP32 board and the correct COM port in Arduino IDE.
3. Upload the code and open Serial Monitor at `115200` baud.
4. Open the printed IP address in a browser connected to the same Wi-Fi network.
5. Enter a message such as `HELLO WORLD` and click **Flash Morse Code**.

## Notes

- The sketch supports letters A–Z and digits 0–9. Unsupported punctuation is ignored.
- The external LED must be connected through a resistor.
- The code uses `delay()` while flashing, so the ESP32 cannot process another web request until the current message finishes.
- The sketch is written for the ESP32 Arduino core with its built-in `WiFi.h` and `WebServer.h` libraries. It has not been compiled on the physical board, so successful compilation and operation should be confirmed in Arduino IDE.
