# Task 6 – Flashing Morse Code using ESP32

## Connections

| ESP32 DevKit V1 | Component |
|---|---|
| GPIO 4 | Connect to one end of the 220Ω resistor |
| Other end of resistor | LED long leg (Anode +) |
| LED short leg (Cathode −) | GND |
| USB port | Connect ESP32 to laptop |

Components used: ESP32 DevKit V1, one external LED, 220Ω resistor, breadboard, jumper wires and USB cable.

## Full Source Code

Save the following code as `Task6_MorseCode.ino` and open it in Arduino IDE.

```cpp
#include <WiFi.h>
#include <WebServer.h>

// Wi-Fi credentials
const char* ssid = "YOUR_WIFI_NAME";
const char* password = "YOUR_WIFI_PASSWORD";

// LED connection
const int LED_PIN = 4;

// Web server on HTTP port 80
WebServer server(80);

// Morse timing in milliseconds
const unsigned int DOT_TIME = 250;
const unsigned int DASH_TIME = 750;
const unsigned int SYMBOL_GAP = 250;
const unsigned int LETTER_GAP = 750;
const unsigned int WORD_GAP = 1750;

// Morse codes for A-Z
const char* letters[26] = {
  ".-", "-...", "-.-.", "-..", ".", "..-.", "--.",
  "....", "..", ".---", "-.-", ".-..", "--", "-.",
  "---", ".--.", "--.-", ".-.", "...", "-", "..-",
  "...-", ".--", "-..-", "-.--", "--.."
};

// Morse codes for digits 0-9
const char* numbers[10] = {
  "-----", ".----", "..---", "...--", "....-",
  ".....", "-....", "--...", "---..", "----."
};

// Convert normal text into Morse code
String convertToMorse(String text) {
  String morse = "";
  text.toUpperCase();

  for (int i = 0; i < text.length(); i++) {
    char c = text[i];

    if (c >= 'A' && c <= 'Z') {
      if (morse.length() > 0 &&
          morse[morse.length() - 1] != '/') {
        morse += " ";
      }
      morse += letters[c - 'A'];
    }
    else if (c >= '0' && c <= '9') {
      if (morse.length() > 0 &&
          morse[morse.length() - 1] != '/') {
        morse += " ";
      }
      morse += numbers[c - '0'];
    }
    else if (c == ' ') {
      if (morse.length() > 0 &&
          morse[morse.length() - 1] != '/') {
        morse += " /";
      }
    }
  }

  return morse;
}

// Flash a Morse dot
void dot() {
  digitalWrite(LED_PIN, HIGH);
  delay(DOT_TIME);
  digitalWrite(LED_PIN, LOW);
  delay(SYMBOL_GAP);
}

// Flash a Morse dash
void dash() {
  digitalWrite(LED_PIN, HIGH);
  delay(DASH_TIME);
  digitalWrite(LED_PIN, LOW);
  delay(SYMBOL_GAP);
}

// Flash the complete Morse message
void flashMorse(const String& morse) {
  for (int i = 0; i < morse.length(); i++) {
    char symbol = morse[i];

    if (symbol == '.') {
      dot();
    }
    else if (symbol == '-') {
      dash();
    }
    else if (symbol == ' ') {
      delay(LETTER_GAP - SYMBOL_GAP);
    }
    else if (symbol == '/') {
      delay(WORD_GAP - LETTER_GAP);
    }
  }

  digitalWrite(LED_PIN, LOW);
}

// Generate the webpage
String makePage(const String& message = "",
                const String& morse = "",
                const String& status = "") {
