## 3. Sketch A — ESP32-A Sender and Web Server

```cpp
#include <WiFi.h>
#include <WebServer.h>
#include <Wire.h>

// Replace with your Wi-Fi details.
const char* WIFI_SSID = "YOUR_WIFI_NAME";
const char* WIFI_PASSWORD = "YOUR_WIFI_PASSWORD";

// I2C connection to ESP32-B.
const int SDA_PIN = 21;
const int SCL_PIN = 22;
const uint8_t RECEIVER_ADDRESS = 0x55;

WebServer server(80);

String lastMessage = "";

void handleRoot() {
  String page = R"rawliteral(
<!DOCTYPE html>
<html>
<head>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>MARVEL I2C Sender</title>
</head>
<body>
  <h2>ESP32-A Message Sender</h2>
  <form action="/send" method="GET">
    <label>Enter message (maximum 32 characters):</label><br>
    <input type="text" name="msg" maxlength="32" required>
    <button type="submit">Send Message</button>
  </form>
  <p>Submit a message to transmit it to ESP32-B.</p>
</body>
</html>
)rawliteral";

  server.send(200, "text/html", page);
}

void handleSend() {
  if (!server.hasArg("msg")) {
    server.send(400, "text/plain", "Missing msg parameter");
    return;
  }

  String message = server.arg("msg");
  message.trim();

  if (message.length() == 0 || message.length() > 32) {
    server.send(400, "text/plain",
                "Message must contain 1 to 32 characters.");
    return;
  }

  // Send the message bytes to the I2C receiver.
  Wire.beginTransmission(RECEIVER_ADDRESS);

  size_t written = Wire.write(
    (const uint8_t*)message.c_str(),
    message.length()
  );

  uint8_t error = Wire.endTransmission();

  if (written == message.length() && error == 0) {
    lastMessage = message;

    Serial.print("Message sent: ");
    Serial.println(message);

    server.send(
      200,
      "text/html",
      "<h3>Message sent successfully.</h3>"
      "<p>Message: " + message + "</p>"
      "<a href='/'>Send another message</a>"
    );
  } else {
    Serial.print("I2C transmission failed. Error: ");
    Serial.println(error);

    server.send(
      500,
      "text/plain",
      "I2C transmission failed. Check wiring and receiver power."
    );
  }
}

void setup() {
  Serial.begin(115200);

  // Initialize ESP32-A as the I2C master.
  Wire.begin(SDA_PIN, SCL_PIN, 100000);

  WiFi.mode(WIFI_STA);
  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);

  Serial.print("Connecting to Wi-Fi");

  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }

  Serial.println();
  Serial.println("Wi-Fi connected.");
  Serial.print("Sender IP address: ");
  Serial.println(WiFi.localIP());

  server.on("/", HTTP_GET, handleRoot);
  server.on("/send", HTTP_GET, handleSend);

  server.begin();
  Serial.println("Sender web server started.");
}

void loop() {
  server.handleClient();
}
```

